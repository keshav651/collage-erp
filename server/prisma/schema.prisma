// ============================================================
// PRISMA CLIENT
// ============================================================

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// DATABASE
// Prisma 7 me DATABASE_URL prisma.config.ts se read hota hai.
// ============================================================

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  TEACHER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum UnitTestMarkStatus {
  PENDING
  PRESENT
  ABSENT
}

// ============================================================
// USER
// ============================================================

model User {
  id            String     @id @default(uuid())
  googleId      String?    @unique
  email         String     @unique
  name          String
  emailVerified Boolean    @default(false)
  passwordHash  String?
  role          UserRole
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  teacherProfile        TeacherProfile?
  createdUnitTestCycles UnitTestCycle[]
}

// ============================================================
// TEACHER PROFILE
// ============================================================

model TeacherProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  teacherCode String  @unique
  name        String
  phone       String?
  branchId    String

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments          TeacherSubjectAssignment[]
  attendanceSessions   AttendanceSession[]
  marksAssessments     MarksAssessment[]
  unitTestMarksEntered UnitTestMark[]
}

// ============================================================
// BRANCH
// ============================================================

model Branch {
  id                String @id @default(uuid())
  name              String @unique
  codePrefix        String @unique
  nextTeacherNumber Int    @default(0)

  students           Student[]
  attendanceSessions AttendanceSession[]
  marksAssessments   MarksAssessment[]
  teachers           TeacherProfile[]
  unitTestCycles     UnitTestCycle[]
  subjects           Subject[]
}

// ============================================================
// SEMESTER
// ============================================================

model Semester {
  id     String @id @default(uuid())
  number Int    @unique

  students           Student[]
  attendanceSessions AttendanceSession[]
  marksAssessments   MarksAssessment[]
  unitTestCycles     UnitTestCycle[]
  subjects           Subject[]
}

// ============================================================
// SUBJECT
// ============================================================

model Subject {
  id   String @id @default(uuid())
  name String
  code String @unique

  branchId   String?
  semesterId String

  branch   Branch?  @relation(fields: [branchId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  assignments        TeacherSubjectAssignment[]
  attendanceSessions AttendanceSession[]
  marksAssessments   MarksAssessment[]
  unitTests          UnitTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, semesterId])
}

// ============================================================
// STUDENT
// ============================================================

model Student {
  id     String @id @default(uuid())
  rollNo String @unique
  name   String

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  attendanceRecords AttendanceRecord[]
  marksRecords      MarksRecord[]
  unitTestMarks     UnitTestMark[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([semesterId])
  @@index([branchId, semesterId])
}

// ============================================================
// TEACHER SUBJECT ASSIGNMENT
// ============================================================

model TeacherSubjectAssignment {
  id        String @id @default(uuid())
  teacherId String
  subjectId String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  subject Subject        @relation(fields: [subjectId], references: [id])

  academicYear String
  active       Boolean  @default(true)
  assignedAt   DateTime @default(now())

  @@unique([teacherId, subjectId, academicYear])
  @@index([teacherId])
  @@index([subjectId])
}

// ============================================================
// ATTENDANCE SESSION
// ============================================================

model AttendanceSession {
  id String @id @default(uuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  attendanceDate DateTime
  sessionNo      Int?

  records   AttendanceRecord[]
  createdAt DateTime           @default(now())

  @@index([attendanceDate])
  @@index([subjectId, attendanceDate])
  @@index([teacherId, attendanceDate])
}

// ============================================================
// ATTENDANCE RECORD
// ============================================================

model AttendanceRecord {
  id String @id @default(uuid())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status   AttendanceStatus
  markedAt DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ============================================================
// MARKS ASSESSMENT
// ============================================================

model MarksAssessment {
  id String @id @default(uuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  title          String
  maxMarks       Float
  assessmentDate DateTime

  records   MarksRecord[]
  createdAt DateTime      @default(now())

  @@index([subjectId, assessmentDate])
}

// ============================================================
// MARKS RECORD
// ============================================================

model MarksRecord {
  id String @id @default(uuid())

  assessmentId String
  assessment   MarksAssessment @relation(fields: [assessmentId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  marks     Float
  remarks   String?
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(uuid())

  userId   String?
  action   String
  entity   String?
  entityId String?
  details  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// STUDENT IMPORT BATCH
// ============================================================

model StudentImportBatch {
  id String @id @default(uuid())

  fileName          String
  totalRecords      Int    @default(0)
  successfulRecords Int    @default(0)
  failedRecords     Int    @default(0)
  status            String

  createdAt DateTime @default(now())
}

// ============================================================
// UNIT TEST CYCLE
// Admin creates cycles such as UT 1-6 or UT 7-10.
// One deadline applies to the cycle.
// ============================================================

model UnitTestCycle {
  id                 String    @id @default(uuid())
  name               String
  academicYear       String
  startTestNumber    Int
  endTestNumber      Int
  marksEntryDeadline DateTime
  correctionDeadline DateTime?
  correctionReason   String?

  createdByUserId String
  branchId        String?
  semesterId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User     @relation(fields: [createdByUserId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])
  semester  Semester @relation(fields: [semesterId], references: [id])

  tests UnitTest[]

  @@index([branchId, semesterId, academicYear])
  @@index([marksEntryDeadline])
}

// ============================================================
// UNIT TEST
// Each subject has its own test and maximum marks.
// ============================================================

model UnitTest {
  id         String   @id @default(uuid())
  cycleId    String
  subjectId  String
  testNumber Int
  title      String
  maxMarks   Float
  testDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle   UnitTestCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])
  marks   UnitTestMark[]

  @@unique([cycleId, subjectId, testNumber])
  @@index([subjectId, testDate])
}

// ============================================================
// UNIT TEST MARK
// PENDING and ABSENT do not automatically mean zero marks.
// obtainedMarks remains nullable.
// ============================================================

model UnitTestMark {
  id            String             @id @default(uuid())
  unitTestId    String
  studentId     String
  status        UnitTestMarkStatus @default(PENDING)
  obtainedMarks Float?
  enteredById   String?
  enteredAt     DateTime?
  updatedAt     DateTime           @updatedAt

  unitTest UnitTest @relation(fields: [unitTestId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id])

  enteredBy TeacherProfile? @relation(fields: [enteredById], references: [id])

  @@unique([unitTestId, studentId])
  @@index([studentId])
  @@index([enteredById])
}
